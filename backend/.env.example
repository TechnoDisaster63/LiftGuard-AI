# LiftGuard AI backend configuration (all optional - copy to .env and edit)

# API key. Empty = open development mode on localhost.
# SET THIS before exposing the backend to any network: without it, anyone
# who can reach the port can read users/sessions, change settings, enroll
# face data, and control the laser.
# REST clients send:  Authorization: Bearer <key>
# The dashboard appends it to the WebSocket URL as ?token=<key>.
LIFTGUARD_API_KEY=

# Comma-separated browser origins allowed by CORS
LIFTGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional comma-separated ESP32 allowlist for /api/hardware/{id}/connect.
# Empty = any private-network IP or .local hostname is allowed.
# LIFTGUARD_ESP32_ALLOWED_HOSTS=192.168.1.42,liftguard-laser.local

# Face-enrollment upload limits
LIFTGUARD_MAX_REGISTER_IMAGES=30
LIFTGUARD_MAX_IMAGE_BYTES=5242880

# Camera / engine defaults
LIFTGUARD_CAMERA_ID=0
LIFTGUARD_VOICE_ENABLED=true
LIFTGUARD_ARDUINO_ENABLED=true
LIFTGUARD_MODEL_COMPLEXITY=0
LIFTGUARD_PROCESS_EVERY_N=1
LIFTGUARD_USE_TEMPORAL=true
LIFTGUARD_WS_FPS=30
